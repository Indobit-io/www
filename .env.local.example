# --- Required -------------------------------------------------------------

# Postgres. Any provider works (Neon, Supabase, Vercel Postgres, local).
# Tables are created automatically on the first query.
DATABASE_URL=postgres://user:password@host:5432/dbname

# Etherscan V2 — one free key covers every supported chain.
# https://etherscan.io/apis  (free tier: 5 calls/sec, 100k calls/day)
# Without this, no on-chain data can be read. There is no offline substitute.
ETHERSCAN_API_KEY=

# --- Strongly recommended in production -----------------------------------

# Protects /api/cron/* . Vercel Cron sends it as `Authorization: Bearer <secret>`.
# Leave unset and those endpoints are open to anyone who can reach the deployment.
CRON_SECRET=

# Shared-password gate on every page and API route except /login and /api/cron.
# Unset disables auth entirely.
APP_PASSWORD=

# --- Optional -------------------------------------------------------------

# Raises CoinGecko's rate limit. The public tier works but throttles hard.
COINGECKO_API_KEY=
# Set to 1 if the key above is a Pro key rather than a Demo key.
COINGECKO_PRO=

# Minimum spacing between CoinGecko calls, in ms. The default paces for a demo
# key (30/min). Without a key the real limit is nearer 5-15/min, so raise this
# to ~5000 if you see sustained 429s. Spacing calls is much cheaper than
# discovering the limit through retries.
COINGECKO_MIN_INTERVAL_MS=2500

# --- Tuning ---------------------------------------------------------------

# Comma-separated chain ids to index. Supported: 1 (Ethereum), 56 (BNB),
# 8453 (Base), 42161 (Arbitrum). More chains multiply the API call cost.
INDEXED_CHAINS=1

# Minimum USD value for a transfer to be stored. Lower means far more rows and
# a much larger share of the call budget spent on noise.
MIN_TRANSFER_USD=250000

# How many addresses the whale registry keeps.
WHALE_COUNT=500

# Trailing window that defines "whale" and backs the correlation.
WHALE_WINDOW_DAYS=30

# Top-N by market cap considered for the universe, and how many of those are
# actually walked for Transfer logs. Raising TRACKED_TOKENS spreads the same
# call budget more thinly — coverage per token gets worse, not better.
UNIVERSE_SIZE=250
TRACKED_TOKENS=40

# Etherscan calls one ingest run may spend, and the largest block span it will
# request in a single getLogs call.
INGEST_CALL_BUDGET=120
MAX_BLOCK_SPAN=800

# How far back the very first ingest starts, in hours.
BACKFILL_HOURS=24

# Wall-clock ceiling for one price-sync run, in ms. The cron route already
# derives a budget from the platform's function timeout; this only lowers it
# further. The sync stops cleanly when the budget runs out and resumes from the
# least-recently-priced token on the next run, so a partial pass is progress,
# not failure. Leave unset unless you are debugging.
# PRICE_BUDGET_MS=

# A token priced more recently than this is skipped entirely for the run.
PRICE_FRESH_WITHIN_MS=2700000

# Spacing between Etherscan calls, in ms. 220 keeps the free tier's 5/sec happy.
ETHERSCAN_MIN_INTERVAL_MS=220
